# ==============================================================================
# Kharcha Backend Environment Configuration (.env.example)
# Copy this file to .env or set these environment variables in your deployment environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Database Configuration
# For local Compose, set DATABASE_URL=jdbc:postgresql://db:5432/kharcha.
# For running the backend outside Compose, use jdbc:postgresql://localhost:5432/kharcha.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 characters)
# Example: a-very-strong-and-long-random-secret-key-at-least-32-chars
JWT_SECRET=

# CORS Allowed Origin
# Local frontend development: http://localhost:5173
CORS_ALLOWED_ORIGIN=

# Set false for local HTTP. Set true for HTTPS production.
JWT_COOKIE_SECURE=true

# AI Provider API Keys & Limits
AI_ENABLED=false
GEMINI_API_KEY=
GROQ_API_KEY=
AI_DAILY_LIMIT_PER_USER=
SPRINGDOC_ENABLED=false
PORT=8080
