# ==============================================================================
# Kharcha Backend Environment Configuration (.env.example)
# Copy this file to .env or set these environment variables in your deployment environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Database Configuration
# Local Docker Postgres defaults (for local dev/testing):
#   DATABASE_URL=jdbc:postgresql://localhost:5432/kharcha
#   DATABASE_USERNAME=kharcha
#   DATABASE_PASSWORD=kharcha
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT Secret Key (HMAC-SHA256, minimum 256 bits / 32 characters)
# Example: a-very-strong-and-long-random-secret-key-at-least-32-chars
JWT_SECRET=

# CORS Allowed Origin
# Example for local frontend development: http://localhost:5173
CORS_ALLOWED_ORIGIN=

# AI Provider API Keys & Limits (Future integration)
GEMINI_API_KEY=
GROQ_API_KEY=
AI_DAILY_LIMIT_PER_USER=
