{
  "id": "/",
  "name": "Kharcha — Personal expense tracking",
  "short_name": "Kharcha",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "background_color": "#FFFFFF",
  "theme_color": "#FFFFFF",
  "icons": [
    { "src": "/icons/kharcha-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/kharcha-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/import",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
